{
  "name": "next-cookie-bridge",
  "version": "1.0.0",
  "description": "Automate the forwarding of cookies from external APIs to the client in Next.js App Router.",
  "homepage": "https://github.com/joanmat117/next-cookie-bridge",
  "bugs": {
    "url": "https://github.com/joanmat117/next-cookie-bridge/issues"
  },
  "keywords": [
    "typescript",
    "next",
    "cookie"
  ],
  "author": "Joan Matias <joanmat@proton.me> (https://github.com/joanmat117)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joanmat117/next-cookie-bridge.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vitest",
    "build": "tsc",
    "ci": "npm run build && npm run check-format && npm run test",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "next": ">=15.4.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next": "16.1.7",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  },
  "license": "MIT"
}
